# Modalità consentite per questa base read-only: research oppure demo.
TRADING_MODE=research

# Singolo strumento e parametri per il download storico OHLCV da MetaTrader 5.
MT5_SYMBOL=EURUSD
MT5_TIMEFRAME=M15
MT5_BARS=100

# Salva i dati scaricati in data/raw/ se impostato a true.
SAVE_RAW_DATA=false
