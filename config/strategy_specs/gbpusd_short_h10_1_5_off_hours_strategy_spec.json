{
  "schema_version": 1,
  "spec_role": "mt5_ea_translation_signal_parity_strategy_spec",
  "candidate_id": "gbpusd_short_h10_1_5_off_hours",
  "symbol": "GBPUSD",
  "timeframe": "M15",
  "direction": "short",
  "strategy_valid": false,
  "production_valid": false,
  "execution_enabled": false,
  "source_audit": "docs/audits/mt5_ea_translation_feasibility_audit.md",
  "source_strategy_spec_dir": "reports/fixed_candidate_demo_strategy_spec/gbpusd_short_h10_1_5_off_hours_demo_strategy_spec_v5_spread15",
  "threshold_lineage": "train_only",
  "feature_source": {
    "db_path": "data/trading_bot.db",
    "table": "price_features",
    "closed_bar_only": true,
    "time_basis": "broker_server_time_server",
    "feature_generation_source": "scripts/generate_price_features.py"
  },
  "session": {
    "column": "hour_session",
    "required_value": "Off_hours",
    "server_hours": [22, 23],
    "mapping": {
      "Asia": [0, 1, 2, 3, 4, 5, 6, 7],
      "London": [8, 9, 10, 11, 12, 13],
      "New_York": [14, 15, 16, 17, 18, 19, 20, 21],
      "Off_hours": [22, 23]
    }
  },
  "features": {
    "atr_20": {
      "period": 20,
      "method": "simple_moving_average_true_range",
      "formula": "mean(max(high-low, abs(high-previous_close), abs(low-previous_close)), 20)"
    },
    "ma_fast": {
      "period": 20,
      "method": "simple_moving_average_close"
    },
    "close_to_ma_fast_atr_20": {
      "formula": "(close - ma_fast) / atr_20",
      "bucket_source": "train_only_numeric_tercile_thresholds",
      "required_bucket": "high_tercile",
      "low_mid_cutoff": -0.4303672057741361,
      "mid_high_cutoff": 0.5954421525644814,
      "bucket_rules": {
        "low_tercile": "value <= low_mid_cutoff",
        "mid_tercile": "low_mid_cutoff < value <= mid_high_cutoff",
        "high_tercile": "value > mid_high_cutoff"
      }
    },
    "tick_volume_percentile_100": {
      "formula": "count(window_tick_volume <= current_tick_volume) / 100",
      "window": 100,
      "tie_policy": "inclusive_less_than_or_equal",
      "bucket_source": "train_only_numeric_tercile_thresholds",
      "required_bucket": "mid_tercile",
      "low_mid_cutoff": 0.14,
      "mid_high_cutoff": 0.37,
      "bucket_rules": {
        "low_tercile": "value <= low_mid_cutoff",
        "mid_tercile": "low_mid_cutoff < value <= mid_high_cutoff",
        "high_tercile": "value > mid_high_cutoff"
      }
    }
  },
  "entry_rule": {
    "signal_bool_formula": "hour_session == Off_hours AND close_to_ma_fast_atr_20_bucket == high_tercile AND tick_volume_percentile_100_bucket == mid_tercile AND spread <= 15.0",
    "required_close_to_ma_fast_atr_20_bucket": "high_tercile",
    "required_tick_volume_percentile_100_bucket": "mid_tercile",
    "entry_reference_price": "closed_bar_close"
  },
  "spread_policy": {
    "unit": "broker_points",
    "max_spread_points": 15.0,
    "when_missing": "no_signal",
    "when_exceeded": "no_signal"
  },
  "sl_tp": {
    "atr_column": "atr_20",
    "tp_atr": 1.5,
    "sl_atr": 1.0,
    "short_tp_formula": "close - 1.5 * atr_20",
    "short_sl_formula": "close + 1.0 * atr_20",
    "same_bar_policy_research": "stop_first",
    "horizon_bars": 10,
    "target_family": "preferred_1_5atr_1atr_hit_first"
  },
  "trade_lifecycle": {
    "max_holding_bars": 10,
    "timeframe": "M15",
    "exit_policy": "close_at_market_after_10_closed_bars_if_sl_or_tp_not_hit",
    "bar_count_basis": "closed_bars_after_entry",
    "time_basis": "mt5_server_time",
    "no_weekend_hold": true,
    "forced_friday_exit_enabled": true,
    "friday_last_entry_time_server": "23:15",
    "friday_forced_flat_time_server": "23:45",
    "max_exit_time_server_formula": "min(10th_future_m15_closed_bar, friday_forced_flat_time_server_when_applicable)",
    "weekend_crossing_allowed": false,
    "mql5_bar_time_note": "MqlRates.time is the M15 bar open time; friday_last_entry_time_server is an operational entry execution cutoff, not a signal bar timestamp permission.",
    "priority": "sl_tp_first_time_exit_only_if_position_still_open",
    "signal_only_phase_action": "log_requirement_only_no_position_close"
  },
  "risk": {
    "account_currency": "EUR",
    "intended_demo_equity": 1000.0,
    "risk_percent_max": 0.5,
    "risk_amount_max": 5.0,
    "volume_rounding": "floor_to_volume_step",
    "max_margin_usage_ratio": 0.7,
    "max_margin_usage_amount": 700.0,
    "max_margin_usage_warning_ratio": 0.5,
    "max_margin_usage_warning_amount": 500.0,
    "max_open_positions": 1
  },
  "mql5_translation_boundaries": {
    "boundary_note": "The boolean fields below preserve the original signal-parity translation boundary. Current demo EA implementation status is recorded in current_demo_ea_implementation_status and does not change strategy parameters.",
    "signal_only_phase": true,
    "order_check_implemented": false,
    "order_send_implemented": false,
    "current_demo_ea_implementation_status": {
      "signal_parity_passed": true,
      "order_check_demo_only_implemented": true,
      "entry_order_send_demo_only_implemented": true,
      "integrated_lifecycle_watch_implemented": true,
      "integrated_lifecycle_close_preflight_implemented": true,
      "integrated_lifecycle_close_demo_only_implemented": true,
      "risk_based_position_sizing_opt_in_implemented": true,
      "fixed_lot_backward_compatibility_preserved": true,
