    },
    "demo_account_only_required_for_future_trade_ops": true,
    "automatic_retry_allowed": false,
    "loop_or_scheduler_allowed": false,
    "threshold_recalibration_allowed_in_ea": false
  },
  "parity_dataset": {
    "export_script": "scripts/export_fixed_candidate_mt5_ea_parity_dataset.py",
    "required_columns": [
      "time_server",
